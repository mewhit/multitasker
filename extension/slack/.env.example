SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=your-client-secret
SLACK_REDIRECT_URI=http://127.0.0.1:39018/slack/oauth/callback
SLACK_BOT_SCOPES=channels:read,groups:read,im:read,mpim:read,users:read
SLACK_USER_SCOPES=channels:history,channels:read,groups:history,groups:read,im:history,im:read,mpim:history,mpim:read,users:read
SLACK_APP_TOKEN=xapp-your-app-level-token-with-connections-write
SLACK_USER_ID=U1234567890
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_BOT_TOKEN=xoxb-your-bot-token-optional-fallback
SLACK_ONLY_USER_CHANNELS=1
SLACK_LOG_RAW_EVENTS=0
MULTITASKER_SLACK_EVENT_URL=http://127.0.0.1:39017/slack-event

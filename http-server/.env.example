MULTITASKER_DATABASE_URL=postgres://multitasker:multitasker@127.0.0.1:5432/multitasker

# GitHub OAuth App credentials. Set the callback URL in the GitHub OAuth App
# to the exact redirect URI below. The app requests notification read access
# and does not mark inbox items as read.
MULTITASKER_GITHUB_CLIENT_ID=
MULTITASKER_GITHUB_CLIENT_SECRET=
MULTITASKER_GITHUB_REDIRECT_URI=http://127.0.0.1:39017/api/github/oauth/callback
MULTITASKER_GITHUB_POLL_MINUTES=5

# Optional fallback: a classic personal access token with the notifications
# scope can be used instead of OAuth.
MULTITASKER_GITHUB_TOKEN=

# Atlassian OAuth 2.0 (3LO) app credentials.
# Add the Jira platform API with read:jira-work, then configure this exact
# callback URL in the Atlassian developer console.
MULTITASKER_JIRA_CLIENT_ID=
MULTITASKER_JIRA_CLIENT_SECRET=
MULTITASKER_JIRA_REDIRECT_URI=http://127.0.0.1:39017/api/jira/oauth/callback

# Optional when the OAuth grant can access exactly one Jira site; required to
# select the intended site when the Atlassian account can access multiple sites
# (for example, https://your-company.atlassian.net).
MULTITASKER_JIRA_SITE_URL=

# Read-only issue query and recurring polling interval. After starting the HTTP
# server, open http://127.0.0.1:39017/api/jira/oauth/start to connect the app.
MULTITASKER_JIRA_JQL=sprint = "Ready to refine"
MULTITASKER_JIRA_POLL_MINUTES=30

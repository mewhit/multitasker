{
  "name": "multitasker",
  "version": "1.0.0",
  "description": "Electron desktop app",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty",
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k \"tsc -w -p tsconfig.json\" \"wait-on dist/main.js && electron .\"",
    "start": "yarn build && electron ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.7.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
